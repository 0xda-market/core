#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "json"
require "time"
require_relative "../lib/zero_x_da/market/adapters/fx_refresh_runtime"

interval = Integer(ENV.fetch("FX_RATE_REFRESH_INTERVAL_SECONDS", "300"))
retry_interval = Integer(ENV.fetch("FX_RATE_RETRY_INTERVAL_SECONDS", "60"))
unless interval.positive? && retry_interval.positive?
  raise ArgumentError, "FX refresh intervals must be positive"
end

runtime = ZeroXDA::Market::Adapters::FXRefreshRuntime.new(
  database_url: ENV.fetch("DATABASE_URL"),
  provider_name: ENV.fetch("FX_RATE_PROVIDER", "coinbase"),
  request_timeout_seconds: Integer(ENV.fetch("FX_RATE_REQUEST_TIMEOUT_SECONDS", "10"))
)
$stdout.sync = true
$stderr.sync = true
stopping = false
%w[INT TERM].each { |signal| Signal.trap(signal) { stopping = true } }

begin
  until stopping
    delay = interval
    begin
      result = runtime.refresh
      puts JSON.generate(
        status: "ok",
        provider: result.snapshot.provider,
        observed_at: result.snapshot.observed_at.iso8601(6),
        currencies: result.snapshot.rates.keys,
        revision: result.prices.map(&:id).compact.max
      )
    rescue StandardError => error
      delay = retry_interval
      warn JSON.generate(
        status: "error",
        error: error.class.name,
        message: error.message,
        retry_in_seconds: delay
      )
    end

    remaining = delay
    while remaining.positive? && !stopping
      pause = [remaining, 1].min
      sleep(pause)
      remaining -= pause
    end
  end
ensure
  runtime.close
end
