DEPLOY_ENV=development
DOMAIN=0xda-market.nilx.one
MARKET_EDGE_NETWORK=nilx-edge
EDGE_OWNER=infra
PORT=10000
PUMA_THREADS=5

DATABASE_URL=postgresql://postgres:password@host:5432/postgres
PUBLIC_API_TOKEN=replace-me
MANUAL_PROVIDER_TOKEN=replace-me
MANUAL_QUOTE_TTL_SECONDS=900

# Optional issuer API for orders paid in an issuer denomination. Set both or
# neither; the token only sees orders of the named issuer.
ISSUER_API_TOKEN=
ISSUER_API_ISSUER=
# Customer issuer-order routes. Off by default; production refuses to boot with
# them on until a verified customer boundary exists.
ENABLE_ISSUER_ORDER_ROUTES=0
# The issuer's partner lookup endpoint (which issuer account a channel account
# belongs to). Set both or neither; without them lookups are unavailable.
ISSUER_DIRECTORY_URL=
ISSUER_DIRECTORY_TOKEN=
# Comma-separated channel providers the issuer binds, e.g. the messenger the bot runs on.
ISSUER_DIRECTORY_PROVIDERS=

# Provider-neutral profitability gate. Basis points are 1/100 of one percent.
MARKETPLACE_MIN_MARGIN_BPS=100
MARKETPLACE_SUPPLY_BUFFER_BPS=100
MARKETPLACE_VARIABLE_FEE_BPS=0
MARKETPLACE_FIXED_COST_USDT=0
FX_RATE_PROVIDER=coinbase
FX_RATE_REFRESH_INTERVAL_SECONDS=300
FX_RATE_RETRY_INTERVAL_SECONDS=60
FX_RATE_REQUEST_TIMEOUT_SECONDS=10
FX_RATE_MAX_AGE_SECONDS=3600

# Development-only API payment simulator. Production rejects this flag.
ENABLE_MOCK_PAYMENT_PROVIDER=0
MOCK_PAYMENT_PROVIDER_TOKEN=replace-me-for-development-only

# Development core is private to nilx-edge. Set to 1 for production only.
VERIFY_PUBLIC_HTTPS=0
